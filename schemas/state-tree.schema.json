{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rappidai-research.com/schemas/replay/state-tree-v1.json",
  "title": "rappidAI Replay Recursive Tree Object v1",
  "$comment": "Canonical byte ordering, duplicate decoded names, and exact compact JSON encoding are enforced by the Replay canonical parser in addition to these structural constraints.",
  "type": "object",
  "required": ["schema", "entries"],
  "properties": {
    "schema": {"const": "rappid.replay.tree-object/1"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name_b64", "kind", "mode", "object_id"],
        "properties": {
          "name_b64": {
            "type": "string",
            "minLength": 4,
            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
          },
          "kind": {"enum": ["file", "dir", "symlink"]},
          "mode": {"type": "integer", "minimum": 0, "maximum": 4294967295},
          "size": {"type": "integer", "minimum": 1},
          "object_id": {"type": "string", "pattern": "^b3:[0-9a-f]{64}$"}
        },
        "allOf": [
          {
            "if": {"properties": {"kind": {"const": "dir"}}, "required": ["kind"]},
            "then": {"not": {"required": ["size"]}}
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
