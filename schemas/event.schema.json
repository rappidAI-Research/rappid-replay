{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rappidai-research.com/schemas/replay/event-v1.json",
  "title": "rappidAI Replay Event v1",
  "type": "object",
  "required": ["schema", "session_id", "seq", "wall_time_utc", "monotonic_ns", "type", "source", "privacy"],
  "properties": {
    "schema": {"const": "rappid.replay.event/1"},
    "session_id": {
      "type": "string",
      "pattern": "^rp_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "seq": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "wall_time_utc": {"type": "string", "format": "date-time"},
    "monotonic_ns": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "type": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*\\.[a-z][a-z0-9_.-]*$"},
    "source": {"type": "string", "minLength": 1},
    "state_before": {
      "type": "string",
      "pattern": "^st_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "state_after": {
      "type": "string",
      "pattern": "^st_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "parent_event_id": {"type": "string", "minLength": 1},
    "span_id": {"type": "string", "minLength": 1},
    "payload": {},
    "privacy": {
      "type": "object",
      "required": ["classification"],
      "properties": {
        "classification": {"type": "string", "minLength": 1},
        "redacted": {"type": "boolean"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
